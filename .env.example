# Backend environment variables (export in your shell; no dotenv loader)
APP_DEMO_MODE=true
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_HOST:YOUR_PORT/YOUR_DATABASE?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
SPRING_DATASOURCE_USERNAME=YOUR_RUNTIME_ROLE
SPRING_DATASOURCE_PASSWORD=SET_IN_SECRET_STORE
APP_SEED_SYNTHETIC_DATA=false
APP_ALLOW_DEMO_RESET=false
MONITOR_SIMULATION_ENABLED=false
MONITOR_CADENCE_MS=15000
MONITOR_INITIAL_DELAY_MS=15000
API_PROXY_TARGET=http://127.0.0.1:8080
# Frontend uses same-origin /api, proxied by Vite to 127.0.0.1:8080.
# See backend/.env.example for optional simulator settings and docs/backend/tiger-data-setup.md.
# Database credentials belong only in the backend process, never VITE_* variables.
# No hardware or AI integration is enabled or required.
