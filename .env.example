# Vercel server-side settings. Locally copy to ignored .env.local; npm run dev loads it.
# No VITE_* variable may contain database credentials or application secrets.
DATABASE_URL=postgresql://YOUR_HOST:YOUR_PORT/tsdb?sslmode=verify-full
SPRING_DATASOURCE_USERNAME=YOUR_DATABASE_ROLE
SPRING_DATASOURCE_PASSWORD=
# Existing SPRING_DATASOURCE_URL=jdbc:postgresql://... is also accepted instead of DATABASE_URL.
DB_SCHEMA=achillea
DB_POOL_MAX=3
APP_ACCESS_PASSWORD=
APP_SESSION_SECRET=
# Optional exact allowed origin, e.g. https://your-demo.vercel.app (no trailing slash).
# APP_ORIGIN=
# Optional CA PEM when the database uses a private certificate authority.
# DATABASE_CA_CERT=
# Never enable ACHILLEA_TEST_MODE against Tiger/integration data.
