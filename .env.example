# Backend environment variables (export in your shell; no dotenv loader)
APP_DEMO_MODE=true
DATABASE_URL=jdbc:h2:file:./data/achillea
MONITOR_SIMULATION_ENABLED=true
MONITOR_CADENCE_MS=15000
MONITOR_INITIAL_DELAY_MS=15000
API_PROXY_TARGET=http://127.0.0.1:8080
# Frontend uses same-origin /api, proxied by Vite to 127.0.0.1:8080.
# No hardware or AI integration is enabled or required.
