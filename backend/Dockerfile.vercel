FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY pom.xml ./
RUN mvn --batch-mode --no-transfer-progress dependency:go-offline
COPY src ./src
# Run the native PostgreSQL regression suite separately; production has no test binaries.
RUN mvn --batch-mode --no-transfer-progress -DskipTests package

FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
RUN groupadd --system achillea && useradd --system --gid achillea --home-dir /app achillea
COPY --from=build --chown=achillea:achillea /build/target/achillea-0.1.0.jar /app/application.jar
USER achillea
ENV SPRING_PROFILES_ACTIVE=vercel
# Vercel defaults to port 80; the server follows an explicitly supplied PORT.
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=70", "-jar", "/app/application.jar"]
