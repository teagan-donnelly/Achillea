# Backend process secrets; this file is documentation, not an automatic dotenv loader.
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_HOST:YOUR_PORT/YOUR_DATABASE
SPRING_DATASOURCE_USERNAME=YOUR_RUNTIME_ROLE
SPRING_DATASOURCE_PASSWORD=SET_IN_SECRET_STORE
DATABASE_SSLMODE=verify-full
# Optional certificate path when the service requires a supplied trust root:
# PG JDBC URL may include sslrootcert=/absolute/path/root.crt
DB_POOL_MAX=5
DB_POOL_MIN=1
DB_SCHEMA=achillea
# Optional separate Flyway role (standard Boot environment bindings):
# SPRING_FLYWAY_URL=jdbc:postgresql://YOUR_HOST:YOUR_PORT/YOUR_DATABASE?sslmode=verify-full
# SPRING_FLYWAY_USER=YOUR_MIGRATION_ROLE
# SPRING_FLYWAY_PASSWORD=SET_IN_SECRET_STORE
APP_DEMO_MODE=true
APP_SEED_SYNTHETIC_DATA=true
APP_ALLOW_DEMO_RESET=false
MONITOR_SIMULATION_ENABLED=false
SIMULATION_INGESTION_ENABLED=true
# Generate a random secret of at least 24 characters; supply it through backend secrets.
SIMULATION_API_KEY=
SIMULATION_BINDINGS=simulator-001=encounter-synthetic-icu-01
SIMULATION_MAX_BATCH=250
SIMULATION_MAX_BYTES=262144
# Explicit, optional read-only legacy export import into an empty target schema:
# LEGACY_IMPORT_FILE=/absolute/path/synthetic-export.json
